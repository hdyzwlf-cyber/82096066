From f9d1e4e14ec0fdc54cc8bb7503e30fb804cbe4da Mon Sep 17 00:00:00 2001
From: Kiro Agent <244629292+kiro-agent@users.noreply.github.com>
Date: Sat, 16 May 2026 18:39:56 +0000
Subject: [PATCH 01/12] feat(design-system): introduce ink/seal/paper color
 tokens and serif font variables

Co-authored-by: hdyzwlf-cyber <283628485+hdyzwlf-cyber@users.noreply.github.com>
---
 app/globals.css | 353 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 353 insertions(+)

diff --git a/app/globals.css b/app/globals.css
index 1bdad06..34c58f2 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -183,6 +183,66 @@
   --cream-50: #FFFDF7;
   --cream-100: #FFF9E6;
   --cream-200: #FFF3CC;
+
+  /* ============================================
+   * 🖌 沈翔智学 v2 「墨砚」设计系统
+   * (与现有 token 并存，等待业务组件迁移)
+   * ============================================ */
+
+  /* 墨砚绿系（v2 主品牌色） */
+  --ink-50:  #F4F8F4;
+  --ink-100: #E2EBE3;
+  --ink-200: #B8C9BB;
+  --ink-300: #98AE9B;
+  --ink-400: #6E8270;
+  --ink-500: #557158;
+  --ink-600: #3F5A42;
+  --ink-700: #2E4731;
+  --ink-800: #1F3322;
+  --ink-900: #0E1B11;
+
+  /* 朱印红（强调色，仅用于关键 CTA / 评分 / 印章） */
+  --seal-50:  #FAEAE6;
+  --seal-100: #F4D2C9;
+  --seal-300: #E27262;
+  --seal-500: #B23A2C;
+  --seal-600: #8E2D22;
+
+  /* 宣纸米色（背景层级） */
+  --paper-50:  #FBF9F4;
+  --paper-100: #F5F1E6;
+  --paper-200: #EBE4D1;
+  --paper-300: #D9CFB6;
+  --paper-400: #B5A881;
+
+  /* v2 阴影（墨色调，不是紫黑） */
+  --shadow-paper: 0 1px 0 var(--paper-200), 0 8px 24px -8px rgba(14, 27, 17, 0.06);
+  --shadow-elevated: 0 4px 16px -4px rgba(14, 27, 17, 0.12);
+  --shadow-modal: 0 24px 60px -16px rgba(14, 27, 17, 0.18);
+  --shadow-seal: 0 2px 0 var(--seal-500);
+  --shadow-focus-ink: 0 0 0 3px var(--ink-200);
+
+  /* v2 圆角（按"是什么"决定） */
+  --radius-sharp: 2px;
+  --radius-soft: 4px;
+  --radius-card: 12px;
+  --radius-pill: 9999px;
+
+  /* v2 三段式间距 */
+  --space-paper: 12px;
+  --space-section: 64px;
+  --space-page: 120px;
+
+  /* v2 字体（Google Fonts 由 layout.tsx 加载） */
+  --font-display: "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", serif;
+  --font-sans-v2: "Noto Sans SC", "Source Han Sans SC", -apple-system, BlinkMacSystemFont, "PingFang SC", system-ui, sans-serif;
+  --font-mono-v2: "JetBrains Mono", "IBM Plex Mono", "SF Mono", Menlo, Consolas, monospace;
+  --font-hand: "Ma Shan Zheng", "Liu Jian Mao Cao", cursive;
+
+  /* v2 缓动曲线 */
+  --ease-paper-fold: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-ink-spread: cubic-bezier(0.22, 1, 0.36, 1);
+  --ease-seal-stamp: cubic-bezier(0.34, 1.6, 0.64, 1);
 }
 
 .dark {
@@ -213,6 +273,23 @@
   --sidebar-accent-foreground: var(--color-gray-50);
   --sidebar-border: var(--color-gray-700);
   --sidebar-ring: var(--color-primary-400);
+
+  /* === v2 墨砚 - 夜读模式覆盖 === */
+  --paper-50:  #14181A;
+  --paper-100: #1C2225;
+  --paper-200: #283036;
+  --paper-300: #3A434A;
+  --ink-100:   #1F2A22;
+  --ink-200:   #2C3D30;
+  --ink-600:   #87B98C;
+  --ink-700:   #A8D0AC;
+  --ink-800:   #D4E5D6;
+  --ink-900:   #F4F8F4;
+  --seal-300:  #F09A8A;
+  --seal-500:  #E27262;
+  --shadow-paper: 0 1px 0 var(--paper-200), 0 8px 24px -8px rgba(0, 0, 0, 0.32);
+  --shadow-elevated: 0 4px 16px -4px rgba(0, 0, 0, 0.45);
+  --shadow-modal: 0 24px 60px -16px rgba(0, 0, 0, 0.55);
 }
 
 @theme inline {
@@ -1564,3 +1641,279 @@
   outline: 2px solid #10A37F;
   outline-offset: 2px;
 }
+
+
+/* ============================================
+ * 🖌 沈翔智学 v2「墨砚」工具类
+ * 与现有工具类并存，等待业务组件迁移使用
+ * ============================================ */
+
+/* === 字号 / 字体（v2 排版规约） === */
+
+@utility text-hero {
+  font-family: var(--font-display);
+  font-weight: 900;
+  font-size: clamp(40px, 6vw, 88px);
+  line-height: 1.05;
+  letter-spacing: -0.02em;
+}
+
+@utility text-display {
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: clamp(32px, 4.5vw, 56px);
+  line-height: 1.1;
+  letter-spacing: -0.015em;
+}
+
+@utility text-h1-v2 {
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: clamp(28px, 3.5vw, 36px);
+  line-height: 1.2;
+  letter-spacing: -0.01em;
+}
+
+@utility text-h2-v2 {
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: clamp(24px, 3vw, 28px);
+  line-height: 1.3;
+}
+
+@utility text-h3-v2 {
+  font-family: var(--font-sans-v2);
+  font-weight: 600;
+  font-size: 22px;
+  line-height: 1.4;
+}
+
+@utility text-h4-v2 {
+  font-family: var(--font-sans-v2);
+  font-weight: 600;
+  font-size: 18px;
+  line-height: 1.5;
+}
+
+@utility text-body-lg-v2 {
+  font-family: var(--font-sans-v2);
+  font-weight: 400;
+  font-size: 17px;
+  line-height: 1.75;
+}
+
+@utility text-body-v2 {
+  font-family: var(--font-sans-v2);
+  font-weight: 400;
+  font-size: 15px;
+  line-height: 1.7;
+}
+
+@utility text-body-sm-v2 {
+  font-family: var(--font-sans-v2);
+  font-weight: 400;
+  font-size: 14px;
+  line-height: 1.6;
+}
+
+@utility text-caption-v2 {
+  font-family: var(--font-sans-v2);
+  font-weight: 400;
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+@utility text-num {
+  font-family: var(--font-mono-v2);
+  font-feature-settings: "tnum" 1, "lnum" 1;
+  font-weight: 700;
+}
+
+@utility font-display-v2 {
+  font-family: var(--font-display);
+}
+
+@utility font-sans-v2 {
+  font-family: var(--font-sans-v2);
+}
+
+@utility font-mono-v2 {
+  font-family: var(--font-mono-v2);
+}
+
+@utility font-hand-v2 {
+  font-family: var(--font-hand);
+}
+
+/* === 阴影（v2 墨色调） === */
+
+@utility shadow-paper {
+  box-shadow: var(--shadow-paper);
+}
+
+@utility shadow-elevated-v2 {
+  box-shadow: var(--shadow-elevated);
+}
+
+@utility shadow-modal-v2 {
+  box-shadow: var(--shadow-modal);
+}
+
+@utility shadow-seal {
+  box-shadow: var(--shadow-seal);
+}
+
+/* === 圆角 === */
+
+@utility rounded-sharp {
+  border-radius: var(--radius-sharp);
+}
+
+@utility rounded-soft {
+  border-radius: var(--radius-soft);
+}
+
+@utility rounded-card-v2 {
+  border-radius: var(--radius-card);
+}
+
+@utility rounded-pill {
+  border-radius: var(--radius-pill);
+}
+
+/* === 表面色（背景层级） === */
+
+@utility bg-paper {
+  background-color: var(--paper-50);
+}
+
+@utility bg-paper-100 {
+  background-color: var(--paper-100);
+}
+
+@utility bg-paper-200 {
+  background-color: var(--paper-200);
+}
+
+/* === 墨色文字 === */
+
+@utility text-ink-900 {
+  color: var(--ink-900);
+}
+
+@utility text-ink-800 {
+  color: var(--ink-800);
+}
+
+@utility text-ink-700 {
+  color: var(--ink-700);
+}
+
+@utility text-ink-600 {
+  color: var(--ink-600);
+}
+
+@utility text-ink-500 {
+  color: var(--ink-500);
+}
+
+@utility text-ink-400 {
+  color: var(--ink-400);
+}
+
+@utility text-seal-500 {
+  color: var(--seal-500);
+}
+
+@utility text-seal-600 {
+  color: var(--seal-600);
+}
+
+/* === 朱印边框 === */
+
+@utility border-seal {
+  border-color: var(--seal-500);
+}
+
+@utility border-ink {
+  border-color: var(--ink-600);
+}
+
+@utility border-paper-200 {
+  border-color: var(--paper-200);
+}
+
+/* === v2 缓动 === */
+
+@utility ease-paper {
+  transition-timing-function: var(--ease-paper-fold);
+}
+
+@utility ease-ink {
+  transition-timing-function: var(--ease-ink-spread);
+}
+
+@utility ease-seal {
+  transition-timing-function: var(--ease-seal-stamp);
+}
+
+/* ============================================
+ * 🖌 v2 关键帧动画（仅 v2 组件使用）
+ * ============================================ */
+
+@keyframes ink-spread {
+  0% {
+    opacity: 0;
+    transform: translateY(16px);
+    filter: blur(8px);
+  }
+  100% {
+    opacity: 1;
+    transform: translateY(0);
+    filter: blur(0);
+  }
+}
+
+@keyframes seal-stamp {
+  0% {
+    opacity: 0;
+    transform: scale(1.6) rotate(-12deg);
+  }
+  60% {
+    opacity: 0.95;
+    transform: scale(0.9) rotate(-8deg);
+  }
+  100% {
+    opacity: 0.92;
+    transform: scale(1) rotate(-6deg);
+  }
+}
+
+@keyframes brush-stroke {
+  0% { stroke-dashoffset: 180; }
+  100% { stroke-dashoffset: 0; }
+}
+
+@keyframes paper-fold {
+  0% {
+    opacity: 0;
+    transform: rotateY(-25deg);
+    transform-origin: left center;
+  }
+  100% {
+    opacity: 1;
+    transform: rotateY(0);
+  }
+}
+
+@utility animate-ink-spread {
+  animation: ink-spread 0.6s var(--ease-paper-fold) both;
+}
+
+@utility animate-seal-stamp {
+  animation: seal-stamp 0.6s var(--ease-seal-stamp) both;
+}
+
+@utility animate-paper-fold {
+  animation: paper-fold 0.7s var(--ease-paper-fold) both;
+}
-- 
2.50.1

